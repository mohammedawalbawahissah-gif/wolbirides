# --- Core Django ---
# Every real deployment must set a real secret key — the fallback in
# settings.py is only for local dev and must never be used in production.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma-separated, e.g. "api.wolbirides.com,wolbirides.onrender.com".
# Safe to leave empty for local dev (DEBUG=True allows localhost regardless).
DJANGO_ALLOWED_HOSTS=

# --- Database ---
# Leave unset to use local SQLite (dev default). Set this to switch to
# Postgres in staging/production, e.g.:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Redis — required for Channels, Celery, and driver location/matching ---
REDIS_URL=redis://localhost:6379

# --- Africa's Talking (SMS/OTP) — if unset, OTP codes print to console instead ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# --- Email (signup/notification codes sent by email — WR UX overhaul) ---
# Defaults to printing emails to the console if left unset — fine for dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@wolbirides.local

# --- MTN MoMo — unset until a licensed payment provider is confirmed (WR-10.3) ---
MOMO_API_KEY=
MOMO_API_SECRET=

# --- Cloudinary — driver documents, vehicle/profile photos ---
CLOUDINARY_URL=

# --- Anthropic (in-app AI assistant, WR UX overhaul item 3) ---
# Leave unset to disable the assistant endpoint gracefully (returns 503).
ANTHROPIC_API_KEY=

# --- CORS — comma-separated list of allowed frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- WR-18 safety ---
# Emergency number shown after SOS (Ghana's unified emergency line).
SAFETY_EMERGENCY_NUMBER=112
# Base URL of the passenger web app; trip-share links point here.
PASSENGER_WEB_URL=http://localhost:5173
# Check-in timing: prompt when a trip runs past (distance / speed) x factor + grace.
SAFETY_EXPECTED_SPEED_KMH=15
SAFETY_OVERDUE_FACTOR=2
SAFETY_OVERDUE_GRACE_MINUTES=10
# Minutes to wait for a reply before escalating to ops.
SAFETY_CHECKIN_RESPONSE_MINUTES=3

# --- Growth features ---
# WR-19/20: drivers within this many km of the nearest are treated as equally close.
FAIR_QUEUE_BAND_KM=0.5
# WR-20 fairness floor: share of dispatches (PRD 10-20%) that favour the in-band driver with fewest trips this week.
FAIR_QUEUE_SHARE=0.15
# WR-22: bundle plans expiring sooner than this need the buyer's explicit acknowledgement.
BUNDLE_MIN_TERM_DAYS=120
# WR-23: flat GH₵ surcharge on WolbiDeliver parcels.
DELIVERY_SURCHARGE=3.00

# --- MTN MoMo (payments/momo.py) ---
# Leave the keys blank for dev mode (no calls to MTN; MoMo payments auto-approve
# on first status check while MOMO_DEV_AUTO_APPROVE=True).
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS
MOMO_CALLBACK_URL=
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=
MOMO_DEV_AUTO_APPROVE=True

# --- WR-17 shared rides (PRD: 2 riders; base fare shared, own distance, never above solo) ---
POOL_MAX_RIDERS=2
POOL_PICKUP_RADIUS_KM=0.8
POOL_DESTINATION_RADIUS_KM=1.5
POOL_JOIN_WINDOW_MINUTES=5

# --- Deployment ---
# Required when DJANGO_DEBUG=False (the app refuses to start otherwise).
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# Private path for Django admin; required in production, and not "admin" (e.g. ops-7f3k2).
# DJANGO_ADMIN_PATH=
# HTTPS hardening applies automatically when DJANGO_DEBUG=False:
# DJANGO_SECURE_SSL_REDIRECT=True            # set False only if your host already redirects to HTTPS
# DJANGO_SECURE_HSTS_SECONDS=2592000         # 30 days; raise to 31536000 once HTTPS is solid
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False # True only when EVERY subdomain serves HTTPS
# DJANGO_SECURE_HSTS_PRELOAD=False            # browser preload list; hard to undo, enable last

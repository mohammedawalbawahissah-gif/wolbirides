DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Redis — required for Channels, Celery, and driver location/matching
REDIS_URL=redis://localhost:6379

# Postgres (leave unset to use local SQLite for dev)
DATABASE_URL=

# Africa's Talking (SMS/OTP) — if unset, OTP codes print to console instead
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# MTN MoMo — unset until a licensed payment provider is confirmed (WR-10.3)
MOMO_API_KEY=
MOMO_API_SECRET=

# Cloudinary — driver documents, vehicle photos
CLOUDINARY_URL=

# Comma-separated list of allowed origins for the React admin dashboard
CORS_ALLOWED_ORIGINS=http://localhost:5173

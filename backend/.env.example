# --- Core Django ---
# Every real deployment must set a real secret key — the fallback in
# settings.py is only for local dev and must never be used in production.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma-separated, e.g. "api.wolbirides.com,wolbirides.onrender.com".
# Local dev (DEBUG=True): any address is accepted, so a phone works whatever IP your computer has.
# Required when DJANGO_DEBUG=False (an empty list makes Django reject every request): list your real domains.
DJANGO_ALLOWED_HOSTS=

# --- Database ---
# Leave unset to use local SQLite (dev default). Set this to switch to
# Postgres in staging/production, e.g.:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Redis — required for Channels, Celery, and driver location/matching ---
REDIS_URL=redis://localhost:6379

# --- Africa's Talking (SMS/OTP) — if unset, OTP codes print to console instead ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# --- Email via Resend (sign-up and password-reset codes) ---
# Leave RESEND_API_KEY blank in dev: emails print to the console instead.
# DEFAULT_FROM_EMAIL must be an address on a domain you've verified in Resend.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=WolbiRides <no-reply@wolbirides.local>

# --- MTN MoMo — unset until a licensed payment provider is confirmed (WR-10.3) ---
MOMO_API_KEY=
MOMO_API_SECRET=

# --- Cloudflare R2 — driver documents, vehicle/profile photos ---
# R2_ACCOUNT_ID: Cloudflare dashboard > R2 (also in the S3 API address).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 > Manage API tokens (Object Read & Write on the bucket).
# R2_PUBLIC_BASE_URL: the address the bucket is served from, e.g. https://files.yourdomain.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Anthropic (in-app AI assistant, WR UX overhaul item 3) ---
# Leave unset to disable the assistant endpoint gracefully (returns 503).
ANTHROPIC_API_KEY=

# --- CORS — comma-separated list of allowed frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- WR-18 safety ---
# Emergency number shown after SOS (Ghana's unified emergency line).
SAFETY_EMERGENCY_NUMBER=112
# Base URL of the passenger web app; trip-share links point here.
PASSENGER_WEB_URL=http://localhost:5173
# Check-in timing: prompt when a trip runs past (distance / speed) x factor + grace.
SAFETY_EXPECTED_SPEED_KMH=15
SAFETY_OVERDUE_FACTOR=2
SAFETY_OVERDUE_GRACE_MINUTES=10
# Minutes to wait for a reply before escalating to ops.
SAFETY_CHECKIN_RESPONSE_MINUTES=3

# --- Growth features ---
# WR-19/20: drivers within this many km of the nearest are treated as equally close.
FAIR_QUEUE_BAND_KM=0.5
# WR-20 fairness floor: share of dispatches (PRD 10-20%) that favour the in-band driver with fewest trips this week.
FAIR_QUEUE_SHARE=0.15
# WR-22: bundle plans expiring sooner than this need the buyer's explicit acknowledgement.
BUNDLE_MIN_TERM_DAYS=120
# WR-23: flat GH₵ surcharge on WolbiDeliver parcels.
DELIVERY_SURCHARGE=3.00

# --- MTN MoMo (payments/momo.py) ---
# Leave the keys blank for dev mode (no calls to MTN; MoMo payments auto-approve
# on first status check while MOMO_DEV_AUTO_APPROVE=True).
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS
MOMO_CALLBACK_URL=
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=
MOMO_DEV_AUTO_APPROVE=True

# --- Hubtel (payments/hubtel.py) ---
# UNVERIFIED against Hubtel's real API — confirm endpoint paths and field names against
# Hubtel's current docs and a live merchant account before going live (see the module
# docstring). Same dev-mode fallback as MoMo: leave the keys blank locally.
HUBTEL_BASE_URL=https://rmp.hubtel.com
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_CALLBACK_URL=
HUBTEL_DEV_AUTO_APPROVE=True

# --- WR-26 ops-arranged deliveries ---
# Delivery types that wait in the admin "Deliveries" queue for a person to assign, instead of going
# straight to nearby drivers. Parcels dispatch automatically and only reach the queue if no driver
# takes them. Use "errand,vendor_order,parcel" to route everything through ops.
DELIVERY_ADMIN_FIRST_SUBTYPES=errand,vendor_order

# --- WR-17 shared rides (PRD: 2 passengers; base fare shared, own distance, never above solo) ---
POOL_MAX_PASSENGERS=2
POOL_PICKUP_RADIUS_KM=0.8
POOL_DESTINATION_RADIUS_KM=1.5
POOL_JOIN_WINDOW_MINUTES=5

# --- Deployment ---
# Required when DJANGO_DEBUG=False (the app refuses to start otherwise).
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# Private path for Django admin; required in production, and not "admin" (e.g. ops-7f3k2).
# DJANGO_ADMIN_PATH=
# HTTPS hardening applies automatically when DJANGO_DEBUG=False:
# DJANGO_SECURE_SSL_REDIRECT=True            # set False only if your host already redirects to HTTPS
# DJANGO_SECURE_HSTS_SECONDS=2592000         # 30 days; raise to 31536000 once HTTPS is solid
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False # True only when EVERY subdomain serves HTTPS
# DJANGO_SECURE_HSTS_PRELOAD=False            # browser preload list; hard to undo, enable last

# Rider passes: riders pay a daily/weekly pass to go online instead of per-trip commission.
# Leave False for the free soft launch; set True when charging starts. Create plans with
#   python manage.py seed_rider_passes --daily 10      (weekly = 6 x daily unless --weekly given)
# or in the admin dashboard (Riders > rider pass plans).
RIDER_PASS_REQUIRED=False
# Free days each rider gets, starting the first time they go online after charging is on (0 = none).
RIDER_PASS_TRIAL_DAYS=14

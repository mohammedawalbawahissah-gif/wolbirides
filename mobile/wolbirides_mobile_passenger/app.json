{
  "expo": {
    "name": "WolbiRides",
    "slug": "wolbirides-mobile-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wolbi.wolbirides"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16233F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wolbi.wolbirides"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://172.20.10.3:8001/api",
      "wsBaseUrl": "ws://172.20.10.3:8001"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WolbiRides uses your location to set your pickup and to share where you are if you press SOS."
        }
      ],
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "WolbiRides uses your photos only when you choose one for your profile photo.",
          "cameraPermission": "WolbiRides uses the camera only when you take a photo for your profile photo."
        }
      ]
    ]
  }
}
